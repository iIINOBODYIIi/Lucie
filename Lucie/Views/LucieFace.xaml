<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lucie.Views.LucieFace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <UserControl.Resources>
        <Style x:Key="Line" TargetType="Path">
            <Setter Property="Stroke" Value="#EEF1F7" />
            <Setter Property="StrokeThickness" Value="2.2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
    </UserControl.Resources>

    <!-- Visage dessiné sur une grille de 56 x 40, mis à l'échelle automatiquement -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="56" Height="40">
            <Canvas x:Name="FaceRoot" Width="56" Height="40">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="FaceRootRotate" CenterX="28" CenterY="22" />
                        <TranslateTransform x:Name="FaceRootShift" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Casque (musique) -->
                <Canvas x:Name="Headphones" Visibility="Collapsed">
                    <Path Data="M12,23 L12,19 A16,15 0 0 1 44,19 L44,23"
                          Stroke="{StaticResource LucieAccent}" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Rectangle Canvas.Left="8" Canvas.Top="20" Width="7" Height="12" RadiusX="3.5" RadiusY="3.5"
                               Fill="{StaticResource LucieAccent}" />
                    <Rectangle Canvas.Left="41" Canvas.Top="20" Width="7" Height="12" RadiusX="3.5" RadiusY="3.5"
                               Fill="{StaticResource LucieAccent}" />
                </Canvas>

                <!-- Yeux normaux (repos) -->
                <Canvas x:Name="NormalEyes">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="NormalEyesScale" CenterY="20.5" />
                            <TranslateTransform x:Name="NormalEyesShift" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Rectangle Canvas.Left="17" Canvas.Top="15" Width="6" Height="11" RadiusX="3" RadiusY="3" Fill="#EEF1F7" />
                    <Rectangle Canvas.Left="33" Canvas.Top="15" Width="6" Height="11" RadiusX="3" RadiusY="3" Fill="#EEF1F7" />
                </Canvas>

                <!-- Grands yeux ronds avec pupilles (« waouh » et écoute) -->
                <Canvas x:Name="RoundEyes" Visibility="Collapsed">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="RoundEyesScale" CenterY="19" />
                            <TranslateTransform x:Name="RoundEyesShift" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Ellipse Canvas.Left="14.8" Canvas.Top="13.8" Width="10.4" Height="10.4" Fill="#EEF1F7" />
                    <Ellipse Canvas.Left="30.8" Canvas.Top="13.8" Width="10.4" Height="10.4" Fill="#EEF1F7" />
                    <Canvas>
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="PupilShift" />
                        </Canvas.RenderTransform>
                        <Ellipse Canvas.Left="18.1" Canvas.Top="17.1" Width="3.8" Height="3.8" Fill="#1E212B" />
                        <Ellipse Canvas.Left="34.1" Canvas.Top="17.1" Width="3.8" Height="3.8" Fill="#1E212B" />
                    </Canvas>
                </Canvas>

                <!-- Yeux heureux ^ ^ (c'est fait / musique) -->
                <Canvas x:Name="HappyEyes" Visibility="Collapsed">
                    <Path Style="{StaticResource Line}" Data="M17,22 Q20,17.5 23,22" />
                    <Path Style="{StaticResource Line}" Data="M33,22 Q36,17.5 39,22" />
                </Canvas>

                <!-- Yeux fermés (sommeil) -->
                <Canvas x:Name="ClosedEyes" Visibility="Collapsed">
                    <Path Style="{StaticResource Line}" Data="M17,23 L23,23" />
                    <Path Style="{StaticResource Line}" Data="M33,23 L39,23" />
                </Canvas>

                <!-- Bouches -->
                <Path x:Name="MouthSmile" Style="{StaticResource Line}" Data="M24,31 Q28,34 32,31" />
                <Path x:Name="MouthBig" Style="{StaticResource Line}" Data="M23,29 Q28,35 33,29" Visibility="Collapsed" />
                <Ellipse x:Name="MouthO" Canvas.Left="25.6" Canvas.Top="28.2" Width="4.8" Height="5.6"
                         Stroke="#EEF1F7" StrokeThickness="2" Visibility="Collapsed" />
                <Path x:Name="MouthFlat" Style="{StaticResource Line}" Data="M26.5,31 L29.5,31" Visibility="Collapsed" />
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
