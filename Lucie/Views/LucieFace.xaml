<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lucie.Views.LucieFace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <UserControl.Resources>
        <Style x:Key="Line" TargetType="Path">
            <Setter Property="Stroke" Value="#EEF1F7" />
            <Setter Property="StrokeThickness" Value="2.3" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
    </UserControl.Resources>

    <!-- Visage dessiné sur une grille de 56 x 40, mis à l'échelle automatiquement.
         Chaque calque apparaît / disparaît en fondu (voir le code). -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="56" Height="40">
            <Canvas x:Name="FaceRoot" Width="56" Height="40">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="FaceRootScale" CenterX="28" CenterY="30" />
                        <RotateTransform x:Name="FaceRootRotate" CenterX="28" CenterY="22" />
                        <TranslateTransform x:Name="FaceRootShift" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Joues roses (contente, « waouh », musique) -->
                <Canvas x:Name="Blush" Opacity="0">
                    <Ellipse Canvas.Left="10" Canvas.Top="25" Width="8" Height="4.5" Fill="#FF9EB5" Opacity="0.45" />
                    <Ellipse Canvas.Left="38" Canvas.Top="25" Width="8" Height="4.5" Fill="#FF9EB5" Opacity="0.45" />
                </Canvas>

                <!-- Casque, de la même couleur que les yeux -->
                <Canvas x:Name="Headphones" Opacity="0">
                    <Path Data="M11.5,22 L11.5,18 A16.5,15 0 0 1 44.5,18 L44.5,22"
                          Stroke="#EEF1F7" StrokeThickness="2.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Rectangle Canvas.Left="7" Canvas.Top="18.5" Width="8" Height="13" RadiusX="4" RadiusY="4" Fill="#EEF1F7" />
                    <Rectangle Canvas.Left="41" Canvas.Top="18.5" Width="8" Height="13" RadiusX="4" RadiusY="4" Fill="#EEF1F7" />                </Canvas>

                <!-- Yeux normaux (repos) -->
                <Canvas x:Name="NormalEyes">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="NormalEyesScale" CenterY="20" />
                            <TranslateTransform x:Name="NormalEyesShift" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <!-- Halo lumineux autour des yeux -->
                    <Rectangle Canvas.Left="13.5" Canvas.Top="11" Width="12.5" Height="18" RadiusX="6.25" RadiusY="6.25" Fill="#FFFFFF" Opacity="0.07" />
                    <Rectangle Canvas.Left="30" Canvas.Top="11" Width="12.5" Height="18" RadiusX="6.25" RadiusY="6.25" Fill="#FFFFFF" Opacity="0.07" />
                    <Rectangle Canvas.Left="15" Canvas.Top="12.5" Width="9.5" Height="15" RadiusX="4.75" RadiusY="4.75" Fill="#FFFFFF" Opacity="0.12" />
                    <Rectangle Canvas.Left="31.5" Canvas.Top="12.5" Width="9.5" Height="15" RadiusX="4.75" RadiusY="4.75" Fill="#FFFFFF" Opacity="0.12" />
                    <Rectangle Canvas.Left="16.5" Canvas.Top="14" Width="6.5" Height="12" RadiusX="3.25" RadiusY="3.25" Fill="#EEF1F7" />
                    <Rectangle Canvas.Left="33" Canvas.Top="14" Width="6.5" Height="12" RadiusX="3.25" RadiusY="3.25" Fill="#EEF1F7" />
                </Canvas>

                <!-- Grands yeux ronds avec pupilles et reflets (« waouh » et écoute) -->
                <Canvas x:Name="RoundEyes" Opacity="0">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="RoundEyesScale" CenterY="19" />
                            <TranslateTransform x:Name="RoundEyesShift" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Ellipse Canvas.Left="14.2" Canvas.Top="13.2" Width="11.6" Height="11.6" Fill="#EEF1F7" />
                    <Ellipse Canvas.Left="30.2" Canvas.Top="13.2" Width="11.6" Height="11.6" Fill="#EEF1F7" />
                    <Canvas>
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="PupilShift" />
                        </Canvas.RenderTransform>
                        <Ellipse Canvas.Left="17.8" Canvas.Top="16.8" Width="4.4" Height="4.4" Fill="#1E212B" />
                        <Ellipse Canvas.Left="33.8" Canvas.Top="16.8" Width="4.4" Height="4.4" Fill="#1E212B" />
                        <Ellipse Canvas.Left="18.4" Canvas.Top="17.2" Width="1.5" Height="1.5" Fill="White" />
                        <Ellipse Canvas.Left="34.4" Canvas.Top="17.2" Width="1.5" Height="1.5" Fill="White" />
                    </Canvas>
                </Canvas>

                <!-- Yeux heureux ^ ^ (c'est fait / musique) -->
                <Canvas x:Name="HappyEyes" Opacity="0">
                    <Path Style="{StaticResource Line}" Data="M16.5,22 Q19.75,17 23,22" />
                    <Path Style="{StaticResource Line}" Data="M33,22 Q36.25,17 39.5,22" />
                </Canvas>

                <!-- Yeux fermés de sommeil, en arrondi, sans bouche -->
                <Canvas x:Name="SleepEyes" Opacity="0">
                    <Path Style="{StaticResource Line}" Data="M16.5,20.5 Q19.75,24.5 23,20.5" />
                    <Path Style="{StaticResource Line}" Data="M33,20.5 Q36.25,24.5 39.5,20.5" />
                </Canvas>

                <!-- Bouches -->
                <Path x:Name="MouthSmile" Style="{StaticResource Line}" Data="M24.5,30.5 Q28,33.5 31.5,30.5" />
                <Path x:Name="MouthBig" Data="M23,29 Q28,36 33,29 Z" Fill="#EEF1F7" Opacity="0" />
                <Ellipse x:Name="MouthO" Canvas.Left="25.4" Canvas.Top="28" Width="5.2" Height="6" Fill="#EEF1F7" Opacity="0" />
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
