<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lucie.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Lucie.Views">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <!-- Petits Z du sommeil, qui montent doucement en apparaissant puis en s'effaçant -->
            <Storyboard x:Key="SleepStory">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Z1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:0">
                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0.8"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:4.2" Value="0"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="Z1T" Storyboard.TargetProperty="TranslateY" From="0" To="-22" Duration="0:0:4.2" RepeatBehavior="Forever" BeginTime="0:0:0" />
                <DoubleAnimation Storyboard.TargetName="Z1T" Storyboard.TargetProperty="TranslateX" From="0" To="5" Duration="0:0:4.2" RepeatBehavior="Forever" BeginTime="0:0:0" />

                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Z2" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:1.4">
                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0.8"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:4.2" Value="0"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="Z2T" Storyboard.TargetProperty="TranslateY" From="0" To="-22" Duration="0:0:4.2" RepeatBehavior="Forever" BeginTime="0:0:1.4" />
                <DoubleAnimation Storyboard.TargetName="Z2T" Storyboard.TargetProperty="TranslateX" From="0" To="5" Duration="0:0:4.2" RepeatBehavior="Forever" BeginTime="0:0:1.4" />

                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Z3" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:2.8">
                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0.8"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:4.2" Value="0"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="Z3T" Storyboard.TargetProperty="TranslateY" From="0" To="-22" Duration="0:0:4.2" RepeatBehavior="Forever" BeginTime="0:0:2.8" />
                <DoubleAnimation Storyboard.TargetName="Z3T" Storyboard.TargetProperty="TranslateX" From="0" To="5" Duration="0:0:4.2" RepeatBehavior="Forever" BeginTime="0:0:2.8" />
            </Storyboard>

            <!-- Contour qui « respire » + petites barres pendant l'écoute -->
            <Storyboard x:Key="ListenStory">
                <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" From="0.15" To="0.9" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
                <DoubleAnimation Storyboard.TargetName="Bar1S" Storyboard.TargetProperty="ScaleY" From="0.33" To="1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0" />
                <DoubleAnimation Storyboard.TargetName="Bar2S" Storyboard.TargetProperty="ScaleY" From="0.33" To="1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.2" />
                <DoubleAnimation Storyboard.TargetName="Bar3S" Storyboard.TargetProperty="ScaleY" From="0.33" To="1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.4" />
            </Storyboard>

            <!-- Petit éclat de couleur quand une commande a réussi -->
            <Storyboard x:Key="DoneStory">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity">
                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1" />
                    <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Grid.Resources>

        <!-- Le widget : une gélule. La fenêtre est découpée exactement à cette forme. -->
        <Grid x:Name="PillHost" HorizontalAlignment="Right" VerticalAlignment="Top">

            <Border x:Name="Pill" CornerRadius="32" BorderThickness="1">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#30FFFFFF" Offset="0" />
                        <GradientStop Color="#0FFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <Grid x:Name="PillContent" Padding="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="LeftStack" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2">
                        <views:LucieFace x:Name="Face" Width="56" Height="40" />

                        <!-- Barres d'écoute -->
                        <StackPanel x:Name="Bars" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Visibility="Collapsed">
                            <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource LucieAccent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar1S" ScaleY="0.33" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource LucieAccent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar2S" ScaleY="0.33" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource LucieAccent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar3S" ScaleY="0.33" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>

                        <!-- Z du sommeil -->
                        <Canvas x:Name="Zs" Width="18" Height="40" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock x:Name="Z1" Text="z" FontSize="9" FontWeight="SemiBold" Foreground="#C9D2E6" Opacity="0" Canvas.Left="0" Canvas.Top="24">
                                <TextBlock.RenderTransform><CompositeTransform x:Name="Z1T" /></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="Z2" Text="z" FontSize="11" FontWeight="SemiBold" Foreground="#C9D2E6" Opacity="0" Canvas.Left="4" Canvas.Top="22">
                                <TextBlock.RenderTransform><CompositeTransform x:Name="Z2T" /></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="Z3" Text="Z" FontSize="13" FontWeight="SemiBold" Foreground="#C9D2E6" Opacity="0" Canvas.Left="7" Canvas.Top="20">
                                <TextBlock.RenderTransform><CompositeTransform x:Name="Z3T" /></TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </StackPanel>

                    <!-- Mode lecteur -->
                    <Grid x:Name="Player" Grid.Column="1" Margin="12,0,0,0" ColumnSpacing="12"
                          Visibility="Collapsed" Opacity="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Pochette ronde, comme un vinyle -->
                        <Grid Width="80" Height="80">
                            <Ellipse Fill="#2A2F3D" />
                            <FontIcon Glyph="&#xE8D6;" FontSize="24" Foreground="{StaticResource LucieMuted}" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AlbumArt" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TrackTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource LucieInk}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock x:Name="TrackArtist" FontSize="13" Foreground="{StaticResource LucieMuted}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <ProgressBar x:Name="TrackProgress" Margin="0,10,0,0" Minimum="0" Maximum="1"
                                         Foreground="{StaticResource LucieAccent}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Width="44" Height="44" CornerRadius="22" Padding="0"
                                    Background="Transparent" BorderThickness="0" Click="Prev_Click"
                                    ToolTipService.ToolTip="Morceau précédent">
                                <FontIcon Glyph="&#xE892;" FontSize="16" />
                            </Button>
                            <Button Width="44" Height="44" CornerRadius="22" Padding="0"
                                    Background="#1FFFFFFF" BorderThickness="0" Click="PlayPause_Click"
                                    ToolTipService.ToolTip="Lecture / pause">
                                <FontIcon x:Name="PlayIcon" Glyph="&#xE769;" FontSize="16" />
                            </Button>
                            <Button Width="44" Height="44" CornerRadius="22" Padding="0"
                                    Background="Transparent" BorderThickness="0" Click="Next_Click"
                                    ToolTipService.ToolTip="Morceau suivant">
                                <FontIcon Glyph="&#xE893;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Contour coloré (écoute, commande réussie, souris proche) -->
            <Border x:Name="Ring" CornerRadius="32" BorderThickness="2" BorderBrush="{StaticResource LucieAccent}"
                    Opacity="0" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
