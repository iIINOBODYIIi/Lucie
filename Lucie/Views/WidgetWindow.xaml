<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lucie.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Lucie.Views">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <!-- Petits Z du mode sommeil -->
            <Storyboard x:Key="SleepStory">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Z1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:0">
                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0.85" />
                    <LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="Z1T" Storyboard.TargetProperty="TranslateY" From="6" To="-22" Duration="0:0:3.6" RepeatBehavior="Forever" BeginTime="0:0:0" />
                <DoubleAnimation Storyboard.TargetName="Z1T" Storyboard.TargetProperty="TranslateX" From="0" To="10" Duration="0:0:3.6" RepeatBehavior="Forever" BeginTime="0:0:0" />

                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Z2" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:1.2">
                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0.85" />
                    <LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="Z2T" Storyboard.TargetProperty="TranslateY" From="6" To="-22" Duration="0:0:3.6" RepeatBehavior="Forever" BeginTime="0:0:1.2" />
                <DoubleAnimation Storyboard.TargetName="Z2T" Storyboard.TargetProperty="TranslateX" From="0" To="10" Duration="0:0:3.6" RepeatBehavior="Forever" BeginTime="0:0:1.2" />

                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Z3" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:2.4">
                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0.85" />
                    <LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="Z3T" Storyboard.TargetProperty="TranslateY" From="6" To="-22" Duration="0:0:3.6" RepeatBehavior="Forever" BeginTime="0:0:2.4" />
                <DoubleAnimation Storyboard.TargetName="Z3T" Storyboard.TargetProperty="TranslateX" From="0" To="10" Duration="0:0:3.6" RepeatBehavior="Forever" BeginTime="0:0:2.4" />
            </Storyboard>

            <!-- Halo qui respire + petites barres pendant l'écoute -->
            <Storyboard x:Key="ListenStory">
                <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:1.6" RepeatBehavior="Forever" />
                <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.12" Duration="0:0:1.6" RepeatBehavior="Forever" />
                <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.18" Duration="0:0:1.6" RepeatBehavior="Forever" />
                <DoubleAnimation Storyboard.TargetName="Bar1S" Storyboard.TargetProperty="ScaleY" From="0.33" To="1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0" />
                <DoubleAnimation Storyboard.TargetName="Bar2S" Storyboard.TargetProperty="ScaleY" From="0.33" To="1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.2" />
                <DoubleAnimation Storyboard.TargetName="Bar3S" Storyboard.TargetProperty="ScaleY" From="0.33" To="1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.4" />
            </Storyboard>
        </Grid.Resources>

        <!-- Marge transparente autour du widget : place pour le halo, le badge et les Z -->
        <Grid x:Name="PillHost" Margin="24" HorizontalAlignment="Right" VerticalAlignment="Top">

            <Border x:Name="Ring" CornerRadius="22" BorderThickness="2" BorderBrush="{StaticResource LucieAccent}"
                    Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="RingScale" />
                </Border.RenderTransform>
            </Border>

            <Border x:Name="Pill" CornerRadius="22" BorderThickness="1" BorderBrush="#24FFFFFF" Background="#B31E212B">
                <Grid x:Name="PillContent" Padding="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="LeftStack" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2">
                        <views:LucieFace x:Name="Face" Width="56" Height="40" />
                        <StackPanel x:Name="Bars" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Visibility="Collapsed">
                            <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource LucieAccent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar1S" ScaleY="0.33" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource LucieAccent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar2S" ScaleY="0.33" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource LucieAccent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar3S" ScaleY="0.33" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                    </StackPanel>

                    <!-- Mode lecteur -->
                    <Grid x:Name="Player" Grid.Column="1" Margin="12,0,0,0" ColumnSpacing="12"
                          Visibility="Collapsed" Opacity="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="80" Height="80" CornerRadius="14" Background="#2A2F3D">
                            <Grid>
                                <FontIcon Glyph="&#xE8D6;" FontSize="26" Foreground="{StaticResource LucieMuted}" />
                                <Image x:Name="AlbumArt" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TrackTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource LucieInk}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock x:Name="TrackArtist" FontSize="13" Foreground="{StaticResource LucieMuted}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <ProgressBar x:Name="TrackProgress" Margin="0,10,0,0" Minimum="0" Maximum="1"
                                         Foreground="{StaticResource LucieAccent}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="PrevButton" Width="44" Height="44" CornerRadius="22" Padding="0"
                                    Background="Transparent" BorderThickness="0" Click="Prev_Click"
                                    ToolTipService.ToolTip="Morceau précédent">
                                <FontIcon Glyph="&#xE892;" FontSize="16" />
                            </Button>
                            <Button x:Name="PlayButton" Width="44" Height="44" CornerRadius="22" Padding="0"
                                    Background="#1FFFFFFF" BorderThickness="0" Click="PlayPause_Click"
                                    ToolTipService.ToolTip="Lecture / pause">
                                <FontIcon x:Name="PlayIcon" Glyph="&#xE769;" FontSize="16" />
                            </Button>
                            <Button x:Name="NextButton" Width="44" Height="44" CornerRadius="22" Padding="0"
                                    Background="Transparent" BorderThickness="0" Click="Next_Click"
                                    ToolTipService.ToolTip="Morceau suivant">
                                <FontIcon Glyph="&#xE893;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Badge « c'est fait » -->
            <Grid x:Name="Badge" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,-8,-8,0" Visibility="Collapsed" IsHitTestVisible="False">
                <Ellipse Fill="{StaticResource LucieAccent}" />
                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#16181F" />
            </Grid>

            <!-- Z du sommeil -->
            <Canvas x:Name="Zs" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-22,-20,0" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="Z1" Text="z" FontSize="11" FontWeight="SemiBold" Foreground="#C9D2E6" Opacity="0" Canvas.Left="10" Canvas.Top="20">
                    <TextBlock.RenderTransform><CompositeTransform x:Name="Z1T" /></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="Z2" Text="z" FontSize="14" FontWeight="SemiBold" Foreground="#C9D2E6" Opacity="0" Canvas.Left="18" Canvas.Top="12">
                    <TextBlock.RenderTransform><CompositeTransform x:Name="Z2T" /></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="Z3" Text="Z" FontSize="17" FontWeight="SemiBold" Foreground="#C9D2E6" Opacity="0" Canvas.Left="26" Canvas.Top="4">
                    <TextBlock.RenderTransform><CompositeTransform x:Name="Z3T" /></TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
        </Grid>
    </Grid>
</Window>
